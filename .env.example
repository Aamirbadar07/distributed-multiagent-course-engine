# Environment configuration template
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_RESEARCH_MODEL=gemini-2.5-flash
GEMINI_BUILDER_MODEL=gemini-2.5-pro
GEMINI_JUDGE_MODEL=gemini-2.5-pro
MAX_CRITIQUE_ITERATIONS=3
PASSING_SCORE_THRESHOLD=85.0
PORT=8080
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API. Leave unset to disable CORS.
# Never use "*" here: a wildcard origin with credentials is unsafe and browsers reject it.
CORS_ALLOW_ORIGINS=
